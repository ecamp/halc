{
  "name": "halc",
  "version": "1.0.0",
  "description": "The HAL client that does the heavy lifting for talking to your HAL (or other linked data) API",
  "keywords": [
    "HAL",
    "hal+json",
    "HATEOAS",
    "API",
    "REST",
    "client",
    "normalizer",
    "Vue",
    "Pinia",
    "Vuex"
  ],
  "homepage": "https://github.com/ecamp/halc#readme",
  "bugs": {
    "url": "https://github.com/ecamp/halc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecamp/halc.git"
  },
  "license": "MIT",
  "contributors": [
    "Carlo Beltrame",
    "Urban Suppiger",
    "Manuel Meister"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/testing/vitest.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hal": {
      "types": "./dist/hal/index.d.ts",
      "default": "./dist/hal/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/vitest": {
      "types": "./dist/testing/vitest.d.ts",
      "default": "./dist/testing/vitest.js"
    },
    "./plain": {
      "types": "./dist/plain/index.d.ts",
      "default": "./dist/plain/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./pinia": {
      "types": "./dist/pinia/index.d.ts",
      "default": "./dist/pinia/index.js"
    },
    "./vuex": {
      "types": "./dist/vuex/index.d.ts",
      "default": "./dist/vuex/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "tsup",
    "build:types": "node node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit && node node_modules/typescript7/bin/tsc --noEmit -p test",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "url-template": "^3.1.1"
  },
  "peerDependencies": {
    "pinia": "^2.1.0 || ^3.0.0 || ^4.0.0",
    "vitest": ">=3",
    "vue": "^3.4.0",
    "vuex": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vuex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "pinia": "4.1.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vuex": "4.1.0"
  }
}
